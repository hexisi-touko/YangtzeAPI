# Public endpoint
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
TZ=Asia/Shanghai

# Pin this to a tested New API release before a production upgrade.
NEW_API_IMAGE=calciumion/new-api:latest

# Database and cache credentials. Use only [A-Za-z0-9] characters.
POSTGRES_USER=newapi
POSTGRES_DB=newapi
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value

# New API security secrets. Keep these stable after first deployment.
SESSION_SECRET=replace-with-a-long-random-value
CRYPTO_SECRET=replace-with-a-long-random-value

# Runtime safeguards
STREAMING_TIMEOUT=300
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=180
GLOBAL_API_RATE_LIMIT_DURATION=180
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=60
GLOBAL_WEB_RATE_LIMIT_DURATION=180
CRITICAL_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT=20
CRITICAL_RATE_LIMIT_DURATION=1200
